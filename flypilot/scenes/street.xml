<mujoco model="Street scene with people and a cart">
  <!-- flypilot's moving-obstacle scene: the same 6 x 6 m room as CrazySim's scene_obstacles.xml, with a
       walkway (east-west, y 1.0..1.6) and a road (north-south, x 1.2..2.0). The movers are mocap bodies:
       crazysim.py's MoverDriver moves them as flypilot/movers.py commands; until then they are parked
       beside their paths. The drone takes off at (0, 0). Markings are visual only (no contacts, too flat
       for the horizontal range rays). Static obstacles are geoms directly in worldbody: planner.py maps
       those and ignores mover bodies. -->
  <option integrator="RK4" density="1.225" viscosity="1.8e-5" timestep="0.001"/>
  <compiler inertiafromgeom="false" autolimits="true"/>
  <statistic center="0 0 1" extent="3"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.5 0.5 0.5" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 0" fog="1 1 1 0"/>
    <map fogstart="0" fogend="0"/>
    <global azimuth="0" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.32 0.25" rgb2="0.2 0.27 0.2"
             markrgb="0.6 0.6 0.6" width="512" height="512"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="2 2"/>
    <material name="wall" rgba="0.6 0.6 0.65 1"/>
    <material name="walkway" rgba="0.72 0.7 0.66 1"/>
    <material name="road" rgba="0.2 0.2 0.22 1"/>
    <material name="paint" rgba="0.95 0.85 0.3 1"/>
    <material name="trunk" rgba="0.45 0.3 0.2 1"/>
    <material name="obstacle" rgba="0.4 0.5 0.4 1"/>
    <material name="clothes1" rgba="0.2 0.35 0.75 1"/>
    <material name="clothes2" rgba="0.75 0.3 0.25 1"/>
    <material name="skin" rgba="0.85 0.68 0.55 1"/>
    <material name="cart" rgba="0.85 0.15 0.15 1"/>
    <material name="glass" rgba="0.6 0.75 0.85 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="wall_north" type="box" size="3 0.05 2" pos="0 3 1" material="wall"/>
    <geom name="wall_south" type="box" size="3 0.05 2" pos="0 -3 1" material="wall"/>
    <geom name="wall_east" type="box" size="0.05 3 2" pos="3 0 1" material="wall"/>
    <geom name="wall_west" type="box" size="0.05 3 2" pos="-3 0 1" material="wall"/>

    <!-- Markings (visual only) -->
    <geom name="mark_walkway" type="box" size="2.95 0.3 0.002" pos="0 1.3 0.002" material="walkway" contype="0" conaffinity="0"/>
    <geom name="mark_road" type="box" size="0.4 2.95 0.002" pos="1.6 0 0.003" material="road" contype="0" conaffinity="0"/>
    <geom name="mark_line1" type="box" size="0.02 0.2 0.002" pos="1.6 -2.4 0.005" material="paint" contype="0" conaffinity="0"/>
    <geom name="mark_line2" type="box" size="0.02 0.2 0.002" pos="1.6 -1.6 0.005" material="paint" contype="0" conaffinity="0"/>
    <geom name="mark_line3" type="box" size="0.02 0.2 0.002" pos="1.6 -0.8 0.005" material="paint" contype="0" conaffinity="0"/>
    <geom name="mark_line4" type="box" size="0.02 0.2 0.002" pos="1.6 0.0 0.005" material="paint" contype="0" conaffinity="0"/>
    <geom name="mark_line5" type="box" size="0.02 0.2 0.002" pos="1.6 0.8 0.005" material="paint" contype="0" conaffinity="0"/>
    <geom name="mark_line6" type="box" size="0.02 0.2 0.002" pos="1.6 2.4 0.005" material="paint" contype="0" conaffinity="0"/>

    <!-- Static obstacles, off the walkway and the road -->
    <geom name="tree1" type="cylinder" size="0.15 1" pos="-1.4 -1.4 1" material="trunk"/>
    <geom name="bench1" type="box" size="0.5 0.15 0.25" pos="-1.6 2.1 0.25" material="obstacle"/>
    <geom name="crate1" type="box" size="0.25 0.25 0.3" pos="2.5 -1.9 0.3" material="obstacle"/>

    <!-- Movers (mocap). People: 1.7 m tall, 0.18 m body radius. The cart stands in for a car at this
         room's scale: 0.5 m wide, 0.8 m long, 0.6 m tall, long axis along y (it drives along the road). -->
    <body name="person1" mocap="true" pos="-2.6 1.3 0.86">
      <geom name="person1_body" type="capsule" size="0.18 0.55" pos="0 0 -0.1" material="clothes1"/>
      <geom name="person1_head" type="sphere" size="0.11" pos="0 0 0.7" material="skin"/>
    </body>
    <body name="person2" mocap="true" pos="2.6 1.3 0.86">
      <geom name="person2_body" type="capsule" size="0.18 0.55" pos="0 0 -0.1" material="clothes2"/>
      <geom name="person2_head" type="sphere" size="0.11" pos="0 0 0.7" material="skin"/>
    </body>
    <body name="cart1" mocap="true" pos="1.6 -2.5 0.36">
      <geom name="cart1_body" type="box" size="0.25 0.4 0.24" material="cart"/>
      <geom name="cart1_cabin" type="box" size="0.22 0.18 0.06" pos="0 -0.05 0.3" material="glass"/>
    </body>
  </worldbody>
</mujoco>
