+def _ffmpeg_writer(path: str, w: int, h: int, crf: int, pix_fmt: str = 'yuv420p', preset: str = 'veryfast'):
+    """An ffmpeg process encoding raw RGB frames from its stdin to H.264 in `path`. In a session of its own:
+    stopping the simulator's process group mustn't kill it before it has finished the file (and if the
+    simulator dies, its stdin closes, and it finishes the file then)."""
+    import imageio_ffmpeg
+    return subprocess.Popen(
+        [imageio_ffmpeg.get_ffmpeg_exe(), '-loglevel', 'error', '-y', '-f', 'rawvideo', '-pix_fmt', 'rgb24',
+         '-s', f'{w}x{h}', '-r', f'{VIDEO_FPS:g}', '-i', '-', '-c:v', 'libx264', '-preset', preset,
+         '-crf', str(crf), '-pix_fmt', pix_fmt, '-movflags', '+faststart', path],
+        stdin=subprocess.PIPE, start_new_session=True)
+
+
+class VideoRecorder:
+    """Records what the viewer window shows, as a video drawn at full quality once the flight is over.
+
+    Drawing the window's picture offscreen during the flight got ~10 frames a second (every third frame,
+    repeated): under WSL2 every GL context, the viewer's and the FPV camera's too, goes through one
+    translation layer, and reading a frame back takes ~40 ms. So during the flight this only logs, each
+    1 / VIDEO_FPS of simulated time, what a frame needs: the bodies' poses, the propellers' turn, the
+    materials (LEDs), the viewer's camera and options, the markers and the RTF; and agent 0's FPV image and
+    the side panel as they change, into two small video streams. When the simulator stops, render_video()
+    draws every frame from that (_FrameDrawer, as the viewer draws it) in a process of its own and deletes
+    the log: `path` appears when it is done (launch.py waits for it and shows the progress).
+    With a viewer window: its camera (with --chase the follow view), its size, its overlays. Headless: the
+    follow view (ChaseCamera) at VIDEO_SIZE."""
+
+    def __init__(self, model: mujoco.MjModel, body_id: int, path: str, camera: 'CameraRenderer | None' = None):
+        try:
+            import imageio_ffmpeg  # noqa: F401
+        except ImportError:
+            raise RuntimeError('recording video needs imageio-ffmpeg (pip install imageio-ffmpeg; setup.cmd)')
+        if cv2 is None:
+            raise RuntimeError('recording video needs OpenCV (pip install opencv-python)')
+        model.vis.global_.offwidth = max(model.vis.global_.offwidth, VIDEO_MAX_SIZE[0])   # the offscreen
+        model.vis.global_.offheight = max(model.vis.global_.offheight, VIDEO_MAX_SIZE[1])  # buffer must fit
+        self.path, self.codec = os.path.abspath(path), 'H.264'
+        self.parts = self.path + '.parts'
+        shutil.rmtree(self.parts, ignore_errors=True)
+        os.makedirs(self.parts)
+        mujoco.mj_saveModel(model, os.path.join(self.parts, 'model.mjb'), None)
+        self._model, self._camera = model, camera
+        self._props = [b for b in range(model.nbody) if model.body(b).name.startswith('cf0_prop')]
+        self._viewer = self._picker = None
+        self.rtf = lambda: 0.0
+        self._chase = ChaseCamera(body_id)
+        self._period, self._acc = 1.0 / VIDEO_FPS, 1.0 / VIDEO_FPS
+        self._log = {k: [] for k in ('t', 'qpos', 'mocap_pos', 'mocap_quat', 'prop_quat', 'mat_rgba', 'cam_type',
+                                     'cam_lookat', 'cam_az', 'cam_el', 'cam_dist', 'cam_track', 'cam_fixed', 'rtf',
+                                     'opt', 'markers')}
+        self._opts, self._opt_index = [], {}     # distinct viewer options, and their index
+        self._marks, self._mark_index = [], {}   # distinct marker sets
+        self._size = None                        # (w, h, scale): the window's, once it has drawn
+        self._images = queue.Queue()             # per logged frame: (FPV image, its count), for the streams
+        self._streams, self._count = {}, {'fpv': 0, 'panel': 0}
+        self._index = {'fpv': [], 'panel': []}   # per logged frame: its frame in each stream (-1: none)
+        self._fpv_count = self._panel = self._panel_mtime = None
+        self._panel_new = False
+        self._thread = threading.Thread(target=self._stream_loop, daemon=True)
+        self._thread.start()
+
+    def attach_viewer(self, viewer, picker=None, rtf=None):
+        """Record what this viewer window shows (its camera, size, options, markers)."""
+        self._viewer, self._picker = viewer, picker
+        if rtf is not None:
+            self.rtf = rtf
+
+    def maybe_render(self, model: mujoco.MjModel, data: mujoco.MjData, dt: float):
+        """From the physics loop (inside the viewer's lock, with a viewer): log a frame when one is due."""
+        self._acc += dt
+        if self._acc < self._period:
+            return
+        self._acc -= self._period
+        v, log = self._viewer, self._log
+        if self._size is None and v is not None and v.viewport is not None and v.viewport.width > 0:
+            vp = v.viewport
+            s = min(1.0, VIDEO_MAX_SIZE[0] / vp.width, VIDEO_MAX_SIZE[1] / vp.height)
+            self._size = (int(vp.width * s) // 2 * 2, int(vp.height * s) // 2 * 2, s)  # even, as H.264 needs
+        if v is not None:
+            c = v.cam
+            cam = (int(c.type), c.lookat.copy(), float(c.azimuth), float(c.elevation), float(c.distance),
+                   int(c.trackbodyid), int(c.fixedcamid))
+            o = v.opt
+            key = (o.flags.tobytes(), o.geomgroup.tobytes(), o.sitegroup.tobytes(), int(o.frame), int(o.label))
+            if key not in self._opt_index:
+                self._opt_index[key] = len(self._opts)
+                self._opts.append([o.flags.tolist(), o.geomgroup.tolist(), o.sitegroup.tolist(), int(o.frame),
+                                   int(o.label)])
+            opt = self._opt_index[key]
+        else:
+            lookat, azimuth = self._chase.view(data)
+            cam = (int(mujoco.mjtCamera.mjCAMERA_FREE), lookat, azimuth, ChaseCamera.ELEVATION_DEG,
+                   ChaseCamera.DISTANCE_M, -1, -1)
+            opt = -1
+        marks = json.dumps(self._picker.markers if self._picker is not None else [])
+        if marks not in self._mark_index:
+            self._mark_index[marks] = len(self._marks)
+            self._marks.append(marks)
+        for k, x in zip(('t', 'qpos', 'mocap_pos', 'mocap_quat', 'prop_quat', 'mat_rgba', 'cam_type', 'cam_lookat',
+                         'cam_az', 'cam_el', 'cam_dist', 'cam_track', 'cam_fixed', 'rtf', 'opt', 'markers'),
+                        (data.time, data.qpos.copy(), data.mocap_pos.copy(), data.mocap_quat.copy(),
+                         model.body_quat[self._props].copy(), model.mat_rgba.copy(), *cam, self.rtf(), opt,
+                         self._mark_index[marks])):
+            log[k].append(x)
+        cam_r = self._camera
+        self._images.put((cam_r.latest_gray, cam_r.frames_rendered) if cam_r is not None else (None, None))
+
+    def _stream_loop(self):
+        """Writes the FPV image and the side panel to their streams when they change; notes per logged frame
+        which of their frames it shows."""
+        while True:
+            item = self._images.get()
+            if item is None:
+                return
+            fpv, count = item
+            if fpv is not None and count != self._fpv_count:
+                self._fpv_count = count
+                self._put('fpv', np.repeat(fpv[:, :, None], 3, axis=2))
+            self._index['fpv'].append(self._count['fpv'] - 1)
+            panel = self._read_panel()
+            if panel is not None and self._panel_new:
+                self._put('panel', panel)
+            self._index['panel'].append(self._count['panel'] - 1 if panel is not None else -1)
+
+    def _put(self, name: str, rgb: np.ndarray):
+        if name not in self._streams:
+            h, w = rgb.shape[:2]
+            self._streams[name] = (_ffmpeg_writer(os.path.join(self.parts, f'{name}.mkv'), w, h, crf=12,
+                                                  pix_fmt='yuv444p', preset='ultrafast'), (w, h))
+        proc, size = self._streams[name]
+        if (rgb.shape[1], rgb.shape[0]) != size:
+            rgb = cv2.resize(rgb, size, interpolation=cv2.INTER_AREA)
+        try:
+            proc.stdin.write(np.ascontiguousarray(rgb).tobytes())
+            self._count[name] += 1
+        except (BrokenPipeError, OSError):
+            pass
+
+    def _read_panel(self):
+        """The side panel another process writes (ViewerOverlay's format), or None if absent or stale;
+        _panel_new: it changed since last read."""
+        self._panel_new = False
+        try:
+            st = os.stat(OVERLAY_PANEL_PATH)
+        except OSError:
+            return None
+        if time.time() - st.st_mtime > OVERLAY_PANEL_STALE_S:
+            return None
+        if st.st_mtime_ns != self._panel_mtime:
+            try:
+                with open(OVERLAY_PANEL_PATH, 'rb') as f:
+                    data = f.read()
+                magic, w, h = struct.unpack_from('<4sHH', data)
+                if magic == b'CSO1' and len(data) == 8 + w * h * 3:
+                    self._panel = np.frombuffer(data, np.uint8, offset=8).reshape(h, w, 3)
+                    self._panel_mtime, self._panel_new = st.st_mtime_ns, True
+            except (OSError, struct.error, ValueError):
+                pass
+        return self._panel
+
+    def stop(self):
+        """Close the log, and start drawing the video from it in a process of its own."""
+        self._images.put(None)
+        self._thread.join(timeout=10.0)
+        for proc, _ in self._streams.values():
+            try:
+                proc.stdin.close()
+                proc.wait(timeout=20.0)
+            except (OSError, subprocess.TimeoutExpired):
+                pass
+        log, n = self._log, len(self._log['t'])
+        if not n:
+            shutil.rmtree(self.parts, ignore_errors=True)
+            return
+        w, h, scale = self._size or (*VIDEO_SIZE, 1.0)
+        arrays = {k: np.array(v) for k, v in log.items()}
+        arrays.update(fpv=np.array(self._index['fpv'][:n]), panel=np.array(self._index['panel'][:n]))
+        np.savez(os.path.join(self.parts, 'log.npz'), **arrays)
+        with open(os.path.join(self.parts, 'meta.json'), 'w') as f:
+            json.dump({'output': self.path, 'size': [w, h], 'scale': scale, 'props': self._props,
+                       'opts': self._opts, 'markers': [json.loads(m) for m in self._marks]}, f)
+        with open(os.path.join(self.parts, 'render.log'), 'w') as out:
+            subprocess.Popen([sys.executable, os.path.abspath(__file__), '--render-video', self.parts],
+                             stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
+        print(f'[crazysim] video: {n / VIDEO_FPS:.0f} s logged; drawing it to {self.path} '
+              f'({w} x {h}, {self.codec})', flush=True)
+
+
+class _Stream:
+    """Reads a stream VideoRecorder wrote, forward only: frame(i) is its frame i."""
+
+    def __init__(self, path: str):
+        self._cap = cv2.VideoCapture(path) if os.path.exists(path) else None
+        self._i, self._frame = -1, None
+
+    def frame(self, i: int, grey: bool = False):
+        if self._cap is None or i < 0:
+            return None
+        while self._i < i:
+            ok, img = self._cap.read()
+            if not ok:
+                break
+            self._i, self._frame = self._i + 1, img
+        if self._frame is None:
+            return None
+        return cv2.cvtColor(self._frame, cv2.COLOR_BGR2GRAY if grey else cv2.COLOR_BGR2RGB)
+
+
+def render_video(parts: str) -> int:
+    """Draw the video VideoRecorder logged in `parts`, frame by frame, as the viewer showed it; write the
+    progress to parts/progress; then move the video into place and delete the log."""
+    with open(os.path.join(parts, 'meta.json')) as f:
+        meta = json.load(f)
+    log = np.load(os.path.join(parts, 'log.npz'))
+    model = mujoco.MjModel.from_binary_path(os.path.join(parts, 'model.mjb'))
+    data = mujoco.MjData(model)
+    (w, h), scale, props = meta['size'], meta['scale'], meta['props']
+    opts = [(np.array(f, np.uint8), np.array(g, np.uint8), np.array(s, np.uint8), fr, lb)
+            for f, g, s, fr, lb in meta['opts']]
+    drawer = _FrameDrawer(model, w, h, scale)
+    fpv, panel = _Stream(os.path.join(parts, 'fpv.mkv')), _Stream(os.path.join(parts, 'panel.mkv'))
+    tmp = meta['output'] + '.drawing.mp4'
+    out = _ffmpeg_writer(tmp, w, h, VIDEO_CRF)
+    n = len(log['t'])
+    t0 = time.monotonic()
+    for k in range(n):
+        data.time = log['t'][k]
+        data.qpos[:] = log['qpos'][k]
+        data.mocap_pos[:], data.mocap_quat[:] = log['mocap_pos'][k], log['mocap_quat'][k]
+        model.body_quat[props] = log['prop_quat'][k]
+        model.mat_rgba[:] = log['mat_rgba'][k]
+        mujoco.mj_kinematics(model, data)
+        mujoco.mj_camlight(model, data)
+        cam = (int(log['cam_type'][k]), log['cam_lookat'][k], float(log['cam_az'][k]), float(log['cam_el'][k]),
+               float(log['cam_dist'][k]), int(log['cam_track'][k]), int(log['cam_fixed'][k]))
+        opt = opts[log['opt'][k]] if log['opt'][k] >= 0 else None
+        frame = drawer.draw(model, data, cam, opt, meta['markers'][log['markers'][k]], float(log['rtf'][k]),
+                            fpv.frame(int(log['fpv'][k]), grey=True), panel.frame(int(log['panel'][k])))
+        out.stdin.write(frame.tobytes())
+        if k % 30 == 0 or k == n - 1:
+            with open(os.path.join(parts, 'progress'), 'w') as f:
+                f.write(f'{k + 1} {n} {time.monotonic() - t0:.1f}')
+    out.stdin.close()
+    out.wait()
+    drawer.free()
+    os.replace(tmp, meta['output'])
+    shutil.rmtree(parts, ignore_errors=True)
+    print(f'[crazysim] video: {meta["output"]} ({n / VIDEO_FPS:.0f} s, drawn in {time.monotonic() - t0:.0f} s)')
+    return 0
+
+
+# ---------------------------------------------------------------------------
+# Viewer picking: double-clicked points go to another process, which sends back markers to draw
+# ---------------------------------------------------------------------------
+PICK_PORT = int(os.environ.get('CRAZYSIM_PICK_PORT', '5310'))      # clicked points are sent here
+MARKER_PORT = int(os.environ.get('CRAZYSIM_MARKER_PORT', '5311'))  # markers to draw arrive here
+MARKER_STALE_S = 3.0           # remove markers whose sender stopped refreshing them
+_PICK_TAKEN = (0.0, 0.0, -1.0e6)  # written into perturb.localpos once a click has been forwarded
+
+
+class ViewerPicker:
+    """Lets another process take points from the 3D view and draw markers into it (polled by
+    ViewerOverlay's thread).
+
+    A left double-click on static scenery (floor, walls, crates: all world-body geoms) makes the viewer
+    set perturb.select = 0 and perturb.localpos = the clicked point in world coordinates. Each new
+    point is sent to udp://127.0.0.1:PICK_PORT as {"cmd": "pick", "x": .., "y": .., "z": .., "eye": [..]},
+    eye being the camera position (the click ray runs from eye to the point).
+    Double-clicks on bodies (the drone) keep their usual meaning and are not sent.
+
+    Markers arrive on udp://127.0.0.1:MARKER_PORT as {"markers": [...]}, each one of
+      {"kind": "sphere" | "disc", "pos": [x, y, z], "size": radius, "rgba": [r, g, b, a], "label": ".."}
+      {"kind": "line", "from": [x, y, z], "to": [x, y, z], "width": pixels, "rgba": [r, g, b, a]}
+    They are drawn into the viewer's user scene only: not part of the model, so neither the drone's
+    camera nor its range sensors see them.
+    """
+
+    def __init__(self, viewer):
+        self._v = viewer
+        self.markers = []  # the markers drawn now (VideoRecorder draws them too)
+        self._out = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        self._in = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        self._in.setblocking(False)
+        try:
+            self._in.bind(('127.0.0.1', MARKER_PORT))
+        except OSError as e:
+            print(f'[crazysim] viewer markers off: udp port {MARKER_PORT} is busy ({e})')
+            self._in = None
+        self._last_pos = None
+        self._markers_raw, self._markers_t = None, 0.0
+
+    def poll(self):
+        self._forward_pick()
+        self._take_markers()
+
+    def _forward_pick(self):
+        pert, cam = self._v.perturb, self._v.cam
+        with self._v.lock():
+            pos = tuple(float(c) for c in pert.localpos)
+            new = (pert.select == 0 and self._last_pos is not None and pos != self._last_pos
+                   and pos != _PICK_TAKEN)
+            if new:
+                pert.localpos[:] = _PICK_TAKEN  # so a second click on the same spot is new too
+                eye = _camera_eye(cam)
+            self._last_pos = _PICK_TAKEN if new else pos
+        if new:
+            msg = {'cmd': 'pick', 'x': pos[0], 'y': pos[1], 'z': pos[2]}
+            if eye is not None:
+                msg['eye'] = eye  # the click ray runs from here to the point: it may pass through a marker
+            try:
+                self._out.sendto(json.dumps(msg).encode(), ('127.0.0.1', PICK_PORT))
+            except OSError:
+                pass
+
+    def _take_markers(self):
+        raw = None
+        while self._in is not None:
+            try:
+                raw = self._in.recv(65535)
+            except OSError:  # nothing more queued
+                break
+        now = time.monotonic()
+        if raw is not None:
+            self._markers_t = now
+            if raw != self._markers_raw:
+                try:
+                    markers = json.loads(raw)['markers']
+                except (ValueError, KeyError, TypeError):
+                    return
+                self._markers_raw = raw
+                self._draw(markers)
+        elif self._markers_raw is not None and now - self._markers_t > MARKER_STALE_S:
+            self._markers_raw = None
+            self._draw([])
+
+    def _draw(self, markers):
+        self.markers = list(markers)
+        scn = self._v.user_scn
+        with self._v.lock():
+            scn.ngeom = 0
+            for mk in markers:
+                if scn.ngeom >= scn.maxgeom:
+                    break
+                try:
+                    _marker_geom(scn.geoms[scn.ngeom], mk)
+                except (KeyError, TypeError, ValueError):
+                    continue
+                scn.ngeom += 1
+
+
+# ---------------------------------------------------------------------------
+# Movers: scene bodies (people, carts) that another process moves
+# ---------------------------------------------------------------------------
+MOVER_PORT = int(os.environ.get('CRAZYSIM_MOVER_PORT', '5312'))
+MOVER_STALE_S = 0.5  # a mover whose commands stop for this long stands still
+
+
+class MoverDriver:
+    """Moves the scene's mocap bodies (a person, a cart, ...) as another process commands.
+
+    Commands arrive on udp://127.0.0.1:MOVER_PORT as
+        {"movers": {"<body name>": {"p": [x, y, z], "v": [vx, vy, vz], "yaw": degrees}, ...}}
+    Between commands each mover keeps its last velocity, so the motion is smooth at the physics rate
+    even though commands come at ~20 Hz; one whose commands stop for MOVER_STALE_S stands still.
+    Mocap bodies are kinematic: they push the drone on contact but nothing pushes them. The range
+    sensors and the camera see them like any other geometry.
+    """
+
+    def __init__(self, model: mujoco.MjModel):
+        self._ids = {model.body(b).name: int(model.body_mocapid[b])
+                     for b in range(model.nbody) if model.body_mocapid[b] >= 0}
+        self._cmd = {}  # mocap id -> (t, (x, y, z), (vx, vy, vz))
+        self._yaw = {}  # mocap id -> pending quaternion
+        self._sock, self._next_poll = None, 0.0
+        if not self._ids:
+            return
+        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        try:
+            self._sock.bind(('127.0.0.1', MOVER_PORT))
+            self._sock.setblocking(False)
+            print(f'[crazysim] movers {sorted(self._ids)}: commands on udp://127.0.0.1:{MOVER_PORT}')
+        except OSError as e:
+            print(f'[crazysim] movers off: udp port {MOVER_PORT} is busy ({e})')
+            self._sock = None
+
+    def apply(self, data: mujoco.MjData):
+        """Once per physics step, before mj_step."""
+        if self._sock is None:
+            return
+        now = time.perf_counter()
+        if now >= self._next_poll:
+            self._poll(now)
+            self._next_poll = now + 0.01
+            for mid, quat in self._yaw.items():
+                data.mocap_quat[mid] = quat
+            self._yaw.clear()
+        for mid, (t, p, v) in self._cmd.items():
+            dt = min(now - t, MOVER_STALE_S)
+            data.mocap_pos[mid] = (p[0] + v[0] * dt, p[1] + v[1] * dt, p[2] + v[2] * dt)
+
+    def _poll(self, now: float):
+        while True:
+            try:
+                raw = self._sock.recv(65535)
+            except OSError:  # nothing more queued
+                return
+            try:
+                for name, c in json.loads(raw)['movers'].items():
+                    mid = self._ids.get(name)
+                    if mid is None:
+                        continue
+                    self._cmd[mid] = (now, tuple(float(x) for x in c['p'][:3]),
+                                      tuple(float(x) for x in c.get('v', (0.0, 0.0, 0.0))[:3]))
+                    if 'yaw' in c:
+                        half = math.radians(float(c['yaw'])) / 2.0
+                        self._yaw[mid] = (math.cos(half), 0.0, 0.0, math.sin(half))
+            except (ValueError, KeyError, TypeError, AttributeError):
+                continue
+
+
+# ---------------------------------------------------------------------------
+# Compound eye: a ring of ommatidia around a drone, measuring distance (for flypilot's fly-brain policy)
+# ---------------------------------------------------------------------------
+EYE_PORT = int(os.environ.get('CRAZYSIM_EYE_PORT', '5330'))
+EYE_RATE_HZ = 20.0
+EYE_STEP_DEG = 5.0      # ommatidium spacing, as in a fly's eye
+EYE_ELEVATION_DEG = (-90, 30)  # rows from straight down to 30 degrees up: a fly sees below it too
+EYE_GRAZING_COS = 0.26  # hits more than ~75 degrees off the surface normal are reported as unknown (0)
+
+
+class CompoundEye:
+    """Every EYE_STEP_DEG all the way round and over EYE_ELEVATION_DEG, the distance from the drone to the
+    first thing in that direction (mj_multiRay; the drone itself excluded; RANGE_MAX_M if nothing). The
+    directions are level and world-aligned, azimuth 0 = world +x: a stabilized eye, so the drone's turning and
+    tilting don't sweep it across the scene. EYE_RATE_HZ times per simulated second it sends to
+    udp://127.0.0.1:EYE_PORT: b'CSE2', u16 n_az, u16 n_el, i16 lowest and highest elevation (degrees),
+    f64 sim time, f64 x, y, z, then n_el * n_az float16 distances, rows from the lowest elevation up, each row
+    from azimuth 0 counter-clockwise; 0 means unknown (a grazing hit, see maybe_cast)."""
+
+    def __init__(self, model: mujoco.MjModel, body_id: int):
+        self._body = body_id
+        az = np.radians(np.arange(0.0, 360.0, EYE_STEP_DEG))
+        el = np.radians(np.arange(EYE_ELEVATION_DEG[0], EYE_ELEVATION_DEG[1] + 0.1, EYE_STEP_DEG))
+        E, A = np.meshgrid(el, az, indexing='ij')
+        self._vec = np.stack([np.cos(E) * np.cos(A), np.cos(E) * np.sin(A), np.sin(E)], axis=-1).reshape(-1).copy()
+        self._n_az, self._n_el, self._n = len(az), len(el), E.size
+        self._geomid = np.zeros(self._n, np.int32)
+        self._dist = np.zeros(self._n, np.float64)
+        self._normal = np.zeros(3 * self._n, np.float64)
+        self._period, self._acc = 1.0 / EYE_RATE_HZ, 0.0
+        self._sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        self._header = b'CSE2' + struct.pack('<HHhh', self._n_az, self._n_el, *EYE_ELEVATION_DEG)
+        print(f'[crazysim] compound eye: {self._n} ommatidia ({self._n_az} x {self._n_el}, {EYE_STEP_DEG:g} deg) '
+              f'-> udp://127.0.0.1:{EYE_PORT}')
+
+    def maybe_cast(self, model: mujoco.MjModel, data: mujoco.MjData, dt: float):
+        self._acc += dt
+        if self._acc < self._period:
+            return
+        self._acc -= self._period
+        pos = data.xpos[self._body]
+        mujoco.mj_multiRay(model, data, pos, self._vec, None, True, self._body, self._geomid, self._dist,
+                           self._normal, self._n, RANGE_MAX_M)
+        # A ray skimming a surface (e.g. a crate top at flying height) slides along it: a 1 cm bob moves the hit
+        # by ~10 cm, which reads as looming. Such grazing hits are reported as 0 (unknown) instead.
+        facing = np.abs(np.einsum('ij,ij->i', self._normal.reshape(-1, 3), self._vec.reshape(-1, 3)))
+        d = np.where(self._dist < 0, RANGE_MAX_M, np.minimum(self._dist, RANGE_MAX_M))
+        d = np.where((self._dist >= 0) & (facing < EYE_GRAZING_COS), 0.0, d).astype(np.float16)
+        try:
+            self._sock.sendto(self._header + struct.pack('<dddd', data.time, *pos) + d.tobytes(),
+                              ('127.0.0.1', EYE_PORT))
+        except OSError:
+            pass
+
+
+def _camera_eye(cam) -> list | None:
+    """World position of the viewer's free or tracking camera (as mjv_cameraFrame computes it)."""
+    if cam.type not in (mujoco.mjtCamera.mjCAMERA_FREE, mujoco.mjtCamera.mjCAMERA_TRACKING):
+        return None
+    az, el = math.radians(cam.azimuth), math.radians(cam.elevation)
+    forward = (math.cos(el) * math.cos(az), math.cos(el) * math.sin(az), math.sin(el))
+    return [float(cam.lookat[i] - cam.distance * forward[i]) for i in range(3)]
+
+
+def _marker_geom(g, mk: dict):
+    rgba = np.array(mk.get('rgba', (1.0, 1.0, 1.0, 1.0)), dtype=np.float32)
+    kind = mk['kind']
+    if kind == 'line':
+        mujoco.mjv_initGeom(g, mujoco.mjtGeom.mjGEOM_LINE, np.zeros(3), np.zeros(3), np.eye(3).ravel(), rgba)
+        mujoco.mjv_connector(g, mujoco.mjtGeom.mjGEOM_LINE, float(mk.get('width', 2.0)),
+                             np.array(mk['from'], dtype=float), np.array(mk['to'], dtype=float))
+    elif kind in ('sphere', 'disc'):
+        r = float(mk['size'])
+        gtype, size = ((mujoco.mjtGeom.mjGEOM_SPHERE, [r, r, r]) if kind == 'sphere'
+                       else (mujoco.mjtGeom.mjGEOM_CYLINDER, [r, 0.002, 0.0]))  # disc: a flat cylinder
+        mujoco.mjv_initGeom(g, gtype, np.array(size), np.array(mk['pos'], dtype=float), np.eye(3).ravel(), rgba)
+    else:
+        raise ValueError(kind)
+    g.label = str(mk.get('label', ''))[:99]
+
