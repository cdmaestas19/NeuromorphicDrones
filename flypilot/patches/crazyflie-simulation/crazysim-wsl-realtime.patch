+# Chase view and video: the drone from behind and a little above, in the viewer and/or to a file
+# ---------------------------------------------------------------------------
+CHASE = os.environ.get('CRAZYSIM_CHASE', '0') == '1'   # the viewer follows agent 0
+VIDEO_PATH = os.environ.get('CRAZYSIM_VIDEO', '')      # record what the viewer shows to this file (.mp4)
+VIDEO_SIZE = (1280, 720)       # without a viewer window; with one, the window's size
+VIDEO_MAX_SIZE = (2560, 1440)  # a bigger window is recorded scaled down to fit
+VIDEO_FPS = 30.0
+VIDEO_CRF = 18                 # H.264 quality (lower is better; 18 looks like the picture itself)
