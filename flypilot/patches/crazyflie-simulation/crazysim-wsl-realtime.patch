+
+class ChaseCamera:
+    """The view from behind a drone and a little above it, turning with its heading, as a follow camera
+    films it. Its heading and position are smoothed (in simulated time), so the drone's own small
+    corrections don't shake the view and a turn swings it round in about a second."""
+
+    DISTANCE_M = 1.0        # a Crazyflie is 9 cm across: from 2.4 m it was a speck, and posts got in between
+    ELEVATION_DEG = -22.0   # looking down at the drone
+    AIM_ABOVE_M = 0.08      # aim this far above it: the drone sits a little below the middle of the picture
+    YAW_TAU_S = 0.5
+    POS_TAU_S = 0.1
+
+    def __init__(self, body_id: int):
+        self._body = body_id
+        self._t = None
+        self._yaw = 0.0
+        self._pos = np.zeros(3)
+
+    def view(self, data: mujoco.MjData) -> tuple:
+        """(lookat, azimuth deg) for the drone's state in `data`."""
+        pos = data.xpos[self._body]
+        w, x, y, z = data.xquat[self._body]
+        yaw = math.degrees(math.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z)))
+        if self._t is None or data.time < self._t:
+            self._yaw, self._pos[:] = yaw, pos
+        else:
+            dt = data.time - self._t
+            self._yaw += (1.0 - math.exp(-dt / self.YAW_TAU_S)) * ((yaw - self._yaw + 180.0) % 360.0 - 180.0)
+            self._pos += (1.0 - math.exp(-dt / self.POS_TAU_S)) * (pos - self._pos)
+        self._t = data.time
+        return self._pos + np.array([0.0, 0.0, self.AIM_ABOVE_M]), self._yaw
+
+    def apply(self, cam, data: mujoco.MjData):
+        """Point a viewer camera (mjvCamera) at the drone from behind."""
+        lookat, azimuth = self.view(data)
+        cam.type = mujoco.mjtCamera.mjCAMERA_FREE
+        cam.lookat[:] = lookat
+        cam.azimuth, cam.elevation, cam.distance = azimuth, self.ELEVATION_DEG, self.DISTANCE_M
+
+
+class _FrameDrawer:
+    """Draws frames as the viewer window shows them, offscreen, with MuJoCo's own calls (mjr_render,
+    mjr_overlay, mjr_drawPixels, as the viewer does): the scene from a camera, the markers, the RTF and time
+    bottom-left, agent 0's FPV image top-left and the side panel on the right (ViewerOverlay's layout)."""
+
+    def __init__(self, model: mujoco.MjModel, w: int, h: int, scale: float = 1.0):
+        self.w, self.h, self.scale = w, h, scale
+        self.gl = mujoco.GLContext(w, h)  # the GL context lives on the thread that made it
+        self.gl.make_current()
+        self.scn = mujoco.MjvScene(model, maxgeom=10000)
+        self.con = mujoco.MjrContext(model, mujoco.mjtFontScale.mjFONTSCALE_150)
+        mujoco.mjr_setBuffer(mujoco.mjtFramebuffer.mjFB_OFFSCREEN, self.con)
+        self.cam, self.opt, self.pert = mujoco.MjvCamera(), mujoco.MjvOption(), mujoco.MjvPerturb()
+        self.rect = mujoco.MjrRect(0, 0, w, h)
+        self._rgb = np.empty((h, w, 3), np.uint8)
+
+    def draw(self, model: mujoco.MjModel, data: mujoco.MjData, cam: tuple, opt, markers: list, rtf: float,
+             fpv, panel) -> np.ndarray:
+        """The frame, RGB, top row first. cam: (type, lookat, azimuth, elevation, distance, trackbodyid,
+        fixedcamid); opt: the viewer's (flags, geomgroup, sitegroup, frame, label), or None for the defaults;
+        fpv: a grey image or None; panel: an RGB image or None."""
+        w, h, con = self.w, self.h, self.con
+        ctype, lookat, azimuth, elevation, distance, trackbody, fixedcam = cam
+        c = self.cam
+        c.type, c.trackbodyid, c.fixedcamid = ctype, trackbody, fixedcam
+        c.lookat[:] = lookat
+        c.azimuth, c.elevation, c.distance = azimuth, elevation, distance
+        if opt is not None:
+            self.opt.flags[:], self.opt.geomgroup[:], self.opt.sitegroup[:] = opt[0], opt[1], opt[2]
+            self.opt.frame, self.opt.label = opt[3], opt[4]
+        mujoco.mjv_updateScene(model, data, self.opt, self.pert, c, mujoco.mjtCatBit.mjCAT_ALL, self.scn)
+        for mk in markers:
+            if self.scn.ngeom >= self.scn.maxgeom:
+                break
+            try:
+                _marker_geom(self.scn.geoms[self.scn.ngeom], mk)
+            except (KeyError, TypeError, ValueError):
+                continue
+            self.scn.ngeom += 1
+        mujoco.mjr_render(self.rect, self.scn, con)
+        # The text first: mjr_overlay sets up 2-D drawing; images drawn straight after mjr_render came out
+        # wrong (the scene's fog and lighting still applied: white).
+        mujoco.mjr_overlay(mujoco.mjtFont.mjFONT_NORMAL, mujoco.mjtGridPos.mjGRID_BOTTOMLEFT, self.rect,
+                           f'RTF: {rtf:.2f}x', f't={data.time:.1f}s', con)
+        if fpv is not None:
+            if self.scale != 1.0:
+                fpv = cv2.resize(fpv, None, fx=self.scale, fy=self.scale, interpolation=cv2.INTER_AREA)
+            ih, iw = fpv.shape[:2]
+            m = max(1, int(round(10 * self.scale)))
+            if ih + 2 * m < h and iw + 2 * m < w:
+                img = np.ascontiguousarray(np.flip(np.repeat(fpv[:, :, None], 3, axis=2), 0))
+                mujoco.mjr_drawPixels(img.ravel(), None, mujoco.MjrRect(m, h - ih - m, iw, ih), con)
+        if panel is not None:
+            ph, pw = panel.shape[:2]
+            s = min(h / ph, OVERLAY_PANEL_MAX_WIDTH * w / pw)
+            size = (max(1, int(pw * s)), max(1, int(ph * s)))
+            fitted = panel if size == (pw, ph) else cv2.resize(panel, size, interpolation=cv2.INTER_AREA)
+            img = np.ascontiguousarray(np.flip(fitted, 0))
+            mujoco.mjr_drawPixels(img.ravel(), None, mujoco.MjrRect(w - size[0], 0, size[0], size[1]), con)
+        mujoco.mjr_readPixels(self._rgb, None, self.rect, con)
+        return np.flipud(self._rgb)
+
+    def free(self):
+        self.gl.free()
+
